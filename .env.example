# ---- Database (Postgres) ----
# رابط قاعدة Postgres — من Vercel Postgres أو Neon.
# نفس الرابط يُستخدم محلياً وعلى Vercel (تطابق dev/prod).
DATABASE_URL="postgresql://user:pass@host:5432/five500?sslmode=require"

# ---- Auth / Session ----
# سر توقيع الجلسة — ولّد قيمة عشوائية طويلة: openssl rand -hex 32
SESSION_SECRET=""

# ---- OTP (SMS) — تُضاف لاحقاً ----
OTP_PROVIDER="mock"           # mock | unifonic | msegat
OTP_API_KEY=""
OTP_USERNAME=""               # لـ msegat فقط
OTP_SENDER_NAME="FIVE500"

# ---- Moyasar (Payments) — تُضاف لاحقاً ----
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ---- Loyverse POS (Integrations tab في لوحة الإدارة) ----
# Access Token من Loyverse Back Office → Integrations → Access Tokens.
# التفعيل والـ Store ID يُضبطان من لوحة الإدارة (Integrations)؛ لا تأثير على الموقع إن كان غير مضبوط.
LOYVERSE_ACCESS_TOKEN=""
# اختياري — معرّف payment type يُستخدم عند تسجيل الدفع في Loyverse. إن تُرك فارغاً يُكتشف تلقائياً.
LOYVERSE_PAYMENT_TYPE_ID=""

# ---- Admin (لوحة المطبخ) ----
# كلمة مرور موظفي الفرع للدخول على /admin
ADMIN_PASSCODE=""

# ---- Feature Flags ----
FEATURE_ZATCA="off"           # off حتى جاهزية السجل التجاري
