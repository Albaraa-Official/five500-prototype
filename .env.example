# ---- Database (Postgres) ----
# رابط قاعدة Postgres — من Vercel Postgres أو Neon.
# نفس الرابط يُستخدم محلياً وعلى Vercel (تطابق dev/prod).
DATABASE_URL="postgresql://user:pass@host:5432/five500?sslmode=require"

# ---- Auth / Session ----
# سر توقيع الجلسة — ولّد قيمة عشوائية طويلة: openssl rand -hex 32
SESSION_SECRET=""

# ---- OTP (SMS) — تُضاف لاحقاً ----
OTP_PROVIDER="mock"           # mock | unifonic | msegat
OTP_API_KEY=""
OTP_SENDER_NAME="FIVE500"

# ---- Moyasar (Payments) — تُضاف لاحقاً ----
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ---- Admin (لوحة المطبخ) ----
# كلمة مرور موظفي الفرع للدخول على /admin
ADMIN_PASSCODE=""

# ---- Feature Flags ----
FEATURE_ZATCA="off"           # off حتى جاهزية السجل التجاري
